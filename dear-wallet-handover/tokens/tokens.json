{
  "$description": "Dear Wallet design tokens. Every colour in the app must come from these names so a palette swap is instant. Values are final and pass WCAG AA (see docs/BUILD_SPEC.md section 5).",
  "palettes": {
    "cloud": {
      "name": "Cloud Candy", "default": true, "unlock": null,
      "colors": { "bg1": "#F6CDEB", "bg2": "#C6EFDD", "c1": "#FDD2EE", "c2": "#E1D5FD", "c3": "#FDEFC0", "c4": "#B4F2DD", "c5": "#ADD9FE", "surface": "#FFFFFF", "outline": "#4A72A8", "text": "#2E2F73", "btn": "#4A72A8", "btnText": "#FFFFFF" }
    },
    "lilac": {
      "name": "Lilac Sky", "unlock": null,
      "colors": { "bg1": "#E1CBF2", "bg2": "#B9E6EC", "c1": "#FAD6EE", "c2": "#DBCEF8", "c3": "#CBC3F6", "c4": "#88C8F6", "c5": "#DBCEF8", "surface": "#FFFFFF", "outline": "#5F52B8", "text": "#3A2A66", "btn": "#6F60C8", "btnText": "#FFFFFF" }
    },
    "peachfuzz": {
      "name": "Peach Fuzz", "unlock": null,
      "colors": { "bg1": "#B8B8FF", "bg2": "#FFD8BE", "c1": "#FFD8BE", "c2": "#B8B8FF", "c3": "#FFEEDD", "c4": "#FFD8BE", "c5": "#B8B8FF", "surface": "#F8F7FF", "outline": "#5F4FD6", "text": "#3A2A66", "btn": "#6F5CE8", "btnText": "#FFFFFF" }
    },
    "peachsoda": {
      "name": "Peach Soda", "unlock": { "type": "logs", "kind": "kept", "count": 100 },
      "colors": { "bg1": "#F9D2CC", "bg2": "#FAC7C3", "c1": "#FAC7C3", "c2": "#E4D6F2", "c3": "#FFEEDD", "c4": "#E4D6F2", "c5": "#FAC7C3", "surface": "#FFF6F2", "outline": "#835AA5", "text": "#4B2A7B", "btn": "#835AA5", "btnText": "#FFFFFF" }
    },
    "orchid": {
      "name": "Orchid Pop", "unlock": { "type": "diary_lines", "count": 30 },
      "colors": { "bg1": "#FFEAFC", "bg2": "#BEDA62", "c1": "#FFEAFC", "c2": "#9D96FF", "c3": "#FAC75A", "c4": "#BEDA62", "c5": "#9D96FF", "surface": "#FFFFFF", "outline": "#8E1E78", "text": "#5B1E58", "btn": "#C936AE", "btnText": "#FFFFFF" }
    },
    "midnight": {
      "name": "Midnight CD", "unlock": { "type": "kept_total_cents", "amount": 100000 },
      "colors": { "bg1": "#1C1838", "bg2": "#2A2350", "c1": "#332B60", "c2": "#3F3574", "c3": "#332B60", "c4": "#3F3574", "c5": "#332B60", "surface": "#2A2350", "outline": "#B8B8FF", "text": "#F8F7FF", "btn": "#FFD8BE", "btnText": "#1C1838" }
    }
  },
  "derived": {
    "$description": "Computed per palette at runtime from the base colours. Alpha as 0..1.",
    "grid": { "from": "outline", "alpha": 0.12 },
    "shadow": { "from": "outline", "alpha": 0.3 },
    "ring": { "from": "outline", "alpha": 0.35 },
    "scrim": { "from": "bg1", "alpha": 0.7 },
    "soft": { "from": "text", "alpha": 0.75, "use": "placeholder and hint text only" }
  },
  "cardRoles": {
    "c1": "today, highlights, primary title bars",
    "c2": "quest, amount pad keys, secondary title bars",
    "c3": "goal, coin, selected segment",
    "c4": "done states, tags, list title bars",
    "c5": "list rows, accents"
  },
  "fixed": {
    "$description": "Not themed. Stickers are collectibles and keep their own colours; holo is reserved for rare moments.",
    "stickerOutline": "#5B6FB0",
    "stickerInk": "#2E2F73",
    "stickerDieCut": "#FFFFFF",
    "holo": ["#FFC4E6", "#BDEBFF", "#DCCBFF", "#BFF5D8", "#FFEFA8"]
  },
  "type": {
    "families": {
      "script": "Pacifico_400Regular",
      "sans": { "600": "Nunito_600SemiBold", "700": "Nunito_700Bold", "800": "Nunito_800ExtraBold", "900": "Nunito_900Black" },
      "pixel": { "500": "PixelifySans_500Medium", "600": "PixelifySans_600SemiBold" }
    },
    "rules": [
      "script only for screen titles, diary headings, milestone and recap titles, 20 pt and up, a few words at a time",
      "amounts always pixel or sans, never script",
      "pixel tags are UPPERCASE with 0.06em letter spacing",
      "pixel type only at sizes that stay crisp: 11, 12, 13, 15, 16, 18, 22, 24, 30, 44, 48, 52, 56, 96"
    ],
    "scale": {
      "screenTitle": { "family": "script", "size": 30, "lineHeight": 1.3 },
      "heroTitle": { "family": "script", "size": 46, "lineHeight": 1.3 },
      "diaryHeading": { "family": "script", "size": 24, "lineHeight": 1.35 },
      "bigAmount": { "family": "pixel", "weight": 600, "size": 48, "lineHeight": 1.05 },
      "amount": { "family": "pixel", "weight": 600, "size": 18 },
      "tag": { "family": "pixel", "weight": 500, "size": 12, "letterSpacing": 0.06, "case": "upper" },
      "windowTitle": { "family": "pixel", "weight": 500, "size": 13, "letterSpacing": 0.06, "case": "upper" },
      "heading": { "family": "sans", "weight": 900, "size": 17 },
      "body": { "family": "sans", "weight": 700, "size": 15, "lineHeight": 1.4 },
      "label": { "family": "sans", "weight": 800, "size": 13 },
      "button": { "family": "sans", "weight": 900, "size": 16 },
      "caption": { "family": "sans", "weight": 700, "size": 12 }
    }
  },
  "radius": { "chip": 999, "button": 999, "key": 16, "row": 15, "card": 20, "window": 20, "sheet": 28, "cloudCorner": 22 },
  "border": { "width": 2, "heavy": 3, "dashed": "2 dashed outline for optional or empty" },
  "shadow": { "window": "0 5 0 shadow", "button": "0 4 0 shadow", "small": "0 3 0 shadow", "note": "hard offset, no blur" },
  "space": { "screenGutter": 16, "stack": 12, "stackLoose": 14, "windowPadding": 16, "titlebarHeight": 36, "tapTarget": 44 },
  "patterns": {
    "gridPaper": { "cell": 22, "line": 1, "color": "grid" },
    "checker": { "cell": 12, "colors": ["cX", "cY"], "note": "title bars: c1/c2, c4/c5 or c3/c1" },
    "sparkle": "four-point star path M12 1C12.9 7.6 16.4 11.1 23 12C16.4 12.9 12.9 16.4 12 23C11.1 16.4 7.6 12.9 1 12C7.6 11.1 11.1 7.6 12 1Z (24 grid)"
  },
  "layout": { "base": { "w": 390, "h": 844 }, "compactBelowHeight": 740, "minSupported": { "w": 375, "h": 667 } },
  "motion": {
    "spring": { "stiffness": 220, "damping": 14, "mass": 1 },
    "easeOut": [0.2, 0.8, 0.2, 1],
    "durations": { "fast": 150, "base": 220, "slow": 300, "reducedMotionFade": 200 }
  }
}
