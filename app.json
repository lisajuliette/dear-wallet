{
  "expo": {
    "name": "Dear Wallet",
    "slug": "dear-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/app-icon-cloud.png",
    "scheme": "dearwallet",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pixelwitch.dearwallet",
      "icon": "./assets/expo.icon",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Add a photo to a log or loved thing.",
        "NSPhotoLibraryAddUsageDescription": "Save ur recap cards to Photos.",
        "NSFaceIDUsageDescription": "Dear Wallet uses Face ID to keep ur diary private.",
        "NSCameraUsageDescription": "Snap a photo for a log or loved thing, optional.",
        "NSUserNotificationsUsageDescription": "Gentle weekly check-ins — never shamey, only if u turn them on."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.pixelwitch.dearwallet",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6CDEB",
        "foregroundImage": "./assets/icon/android-adaptive-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6CDEB",
          "image": "./assets/splash/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-dev-client",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Add a photo to a log or loved thing.",
          "cameraPermission": "Snap a photo for a log or loved thing, optional."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save ur recap cards to Photos.",
          "savePhotosPermission": "Save ur recap cards to Photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dear Wallet uses Face ID to keep ur diary private."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "mode": "production",
          "enableRemoteNotifications": false
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "30855000-ef80-4234-a684-aa6be5925c16"
      }
    },
    "owner": "stepcraft"
  }
}
